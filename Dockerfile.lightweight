# Lightweight Dockerfile for Sales/Finance modules
# This version excludes heavy ML dependencies (saves ~1.5GB)
FROM python:3.11-slim

WORKDIR /app

# Install minimal system dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    libpq-dev \
    gcc \
    python3-dev \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies (WITHOUT ML packages)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p /app/media /app/staticfiles /app/media/invoices

# Collect static files
RUN python manage.py collectstatic --noinput || true

# Make scripts executable
RUN chmod +x railway_start.sh start.sh

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=config.settings

# Expose port
EXPOSE 8000

# Use JSON array format for CMD to prevent signal issues
CMD ["bash", "railway_start.sh"]
