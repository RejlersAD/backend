# ============================================
# AIFlow Environment Variables Template
# ============================================
# SECURITY: Copy this file to .env and fill in your actual credentials
# NEVER commit .env file to git - it contains secrets!
# ============================================

# Django Configuration
SECRET_KEY=your-secret-key-change-this-in-production
# Dedicated secret for encrypting project-level AI provider keys.
# Generate independently from SECRET_KEY; changing it invalidates stored BYOK keys.
BYOK_ENCRYPTION_KEY=generate-an-independent-high-entropy-secret
PLANNING_INTEGRATION_ENCRYPTION_KEY=generate-a-separate-high-entropy-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_NAME=radai_db
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=db
DB_PORT=5432

# AWS Credentials (REQUIRED for S3 access)
# ⚠️ SECURITY: Never hardcode these in Python files!
# Get from: AWS Console → IAM → Users → Security Credentials
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=your-region

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# Redis Configuration (for Celery)
REDIS_HOST=redis
REDIS_PORT=6379

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@domain.com
EMAIL_HOST_PASSWORD=your-email-password

# Railway Production Settings (Optional)
# DATABASE_URL=postgresql://user:pass@host:port/dbname
# S3_READY=False

# ── Production → Local DB Sync ──────────────────────────────────────────────
# Public connection URL to the Railway production PostgreSQL.
# Used exclusively by: python manage.py sync_from_production
# Get it with: railway variables --service Postgres --json
# Then copy the value of DATABASE_PUBLIC_URL below.
# NEVER set this in production — local dev only.
PROD_DATABASE_URL=postgresql://postgres:<password>@<public-host>:<port>/railway

# Optional tuning for sync_from_production:
# SYNC_BATCH_SIZE=500          # rows per INSERT batch (default: 500)
# SYNC_DEFAULT_MODE=incremental # full | incremental (default: incremental)

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Browser Push API (generate a VAPID pair; keep the private key secret)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:it@radai.ae

# ============================================
# Time Sheet biometric mode (office sync agent)
# ============================================
# Office machine: SQL Server source
TIMESHEET_FEATURE_ENABLED=true
TIMESHEET_INPUT_MODE=hybrid
TIMESHEET_DATA_SOURCE=sqlserver
TIMESHEET_HOST=192.168.99.52
TIMESHEET_PORT=1433
TIMESHEET_USER=<read-only-sql-user>
TIMESHEET_PASSWORD=<sql-password>
TIMESHEET_DATABASE=<attendance-database>
TIMESHEET_TABLE=<schema.attendance-table>
TIMESHEET_COL_EMP_CODE=EmpCode
TIMESHEET_COL_EMP_NAME=EmpName
TIMESHEET_COL_PUNCH_TIME=PunchTime
TIMESHEET_COL_PUNCH_TYPE=PunchType
TIMESHEET_COL_IN_VALUE=IN
TIMESHEET_COL_OUT_VALUE=OUT

# Shared by the office agent and production backend. Generate a strong secret.
TIMESHEET_MIRROR_URL=https://<backend-host>/api/v1/timesheet
TIMESHEET_MIRROR_API_KEY=<strong-shared-secret>

# UAE Matrix timestamps are local time; Production stores them as UTC.
TIMESHEET_INGEST_TZ_OFFSET=4
TIMESHEET_HOURS_MODE=paired
TIMESHEET_OPEN_SHIFT_MAX_HOURS=0
TIMESHEET_MAX_DAILY_HOURS=9
