# Example .env configuration for the RAD AI Attendance Sync Agent
# Copy this file to: C:\RadAI\sync-agent\.env
# Update all values marked with YOUR_*

# ========================================
# Matrix SQL Server Connection (Required)
# ========================================
TIMESHEET_HOST=192.168.99.52
TIMESHEET_PORT=1433
TIMESHEET_USER=YOUR_SQL_USERNAME
TIMESHEET_PASSWORD=YOUR_SQL_PASSWORD
TIMESHEET_DATABASE=YOUR_DATABASE_NAME

# ========================================
# Schema Configuration (Required)
# ========================================
# Table containing punch/attendance events
TIMESHEET_TABLE=dbo.AttendanceLog

# Column names in your attendance table
TIMESHEET_COL_EMPCODE=EmpCode
TIMESHEET_COL_NAME=EmpName
TIMESHEET_COL_PUNCH_TIME=PunchTime
TIMESHEET_COL_PUNCH_TYPE=PunchType

# Optional columns (leave empty if not available)
TIMESHEET_COL_EMAIL=
TIMESHEET_COL_DEPT=

# Punch type values
TIMESHEET_IN_VALUE=IN
TIMESHEET_OUT_VALUE=OUT

# ========================================
# User Master Table (Optional)
# ========================================
# Table containing employee details (Card1, Email, etc.)
TIMESHEET_USER_DETAILS_TABLE=dbo.Mx_VEW_UserDetails

# ========================================
# Railway API Configuration (Required)
# ========================================
# Railway backend URL (production)
RAILWAY_BACKEND_URL=https://aiflowbackend-production.up.railway.app

# Shared secret API key - MUST match Railway environment variable
# Generate a strong random key (32+ characters)
TIMESHEET_MIRROR_API_KEY=YOUR_SHARED_SECRET_KEY_HERE_MINIMUM_32_CHARS

# ========================================
# Sync Settings (Optional)
# ========================================
# Number of events to POST per batch
TIMESHEET_BATCH_SIZE=1000

# Connection timeout in seconds
TIMESHEET_TIMEOUT=10

# ========================================
# IMPORTANT NOTES
# ========================================
# 1. Replace all YOUR_* placeholders with actual values
# 2. Keep this file secure (contains database credentials)
# 3. The TIMESHEET_MIRROR_API_KEY must match the Railway environment variable
# 4. To generate a secure API key, use:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
# 5. After updating this file, restart the sync agent
