# Railway Environment Variables Configuration
# Copy and paste these into Railway Dashboard → Your Project → Variables

# ============================================================================
# CRITICAL: CORS Configuration
# ============================================================================
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://www.radai.ae,https://radai.ae,http://localhost:5173

# ============================================================================
# Django Core Settings
# ============================================================================
DJANGO_SETTINGS_MODULE=config.settings
DEBUG=False
ENVIRONMENT=production
SECRET_KEY=<generate-new-secret-key>
BYOK_ENCRYPTION_KEY=<generate-independent-high-entropy-secret>
PLANNING_INTEGRATION_ENCRYPTION_KEY=<generate-separate-high-entropy-secret>
ALLOWED_HOSTS=aiflowbackend-production.up.railway.app,www.radai.ae,radai.ae

# ============================================================================
# URLs
# ============================================================================
FRONTEND_URL=https://www.radai.ae
BACKEND_URL=https://aiflowbackend-production.up.railway.app

# ============================================================================
# Database (Auto-set by Railway PostgreSQL Plugin)
# Use DATABASE_PRIVATE_URL to avoid egress fees (stays within Railway's private network)
# ============================================================================
DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}

# ============================================================================
# Time Sheet biometric mirror (Production has no route to the office LAN)
# ============================================================================
TIMESHEET_FEATURE_ENABLED=true
TIMESHEET_INPUT_MODE=hybrid
TIMESHEET_DATA_SOURCE=mirror
TIMESHEET_MIRROR_API_KEY=<same-strong-secret-used-by-office-agent>
TIMESHEET_INGEST_TZ_OFFSET=4
TIMESHEET_HOURS_MODE=paired
TIMESHEET_OPEN_SHIFT_MAX_HOURS=0
TIMESHEET_MAX_DAILY_HOURS=9

# ============================================================================
# AWS S3 Configuration
# ============================================================================
AWS_ACCESS_KEY_ID=<your-aws-access-key>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-key>
AWS_STORAGE_BUCKET_NAME=<your-s3-bucket-name>
AWS_S3_REGION_NAME=<your-aws-region>
USE_S3=True

# ============================================================================
# OpenAI API
# ============================================================================
OPENAI_API_KEY=<your-openai-api-key>

# ============================================================================
# Celery Configuration (Async Task Processing)
# ============================================================================
# CRITICAL: Set to False for production to enable async processing
# When False: Long-running tasks (Line List extraction, P&ID processing) run in background
# When True: Tasks block HTTP requests (causes timeouts on Railway)
CELERY_TASK_ALWAYS_EAGER=False
CELERY_BASE_EXTRACTION_PREFER_CELERY=False

# ============================================================================
# Email Configuration (Optional)
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<your-email@gmail.com>
EMAIL_HOST_PASSWORD=<your-app-password>
DEFAULT_FROM_EMAIL=<your-email@gmail.com>

# ============================================================================
# Security Headers
# ============================================================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True

# ============================================================================
# Instructions
# ============================================================================
# 1. Go to Railway Dashboard: https://railway.app/dashboard
# 2. Select your project: aiflowbackend-production
# 3. Click on "Variables" tab
# 4. Click "Raw Editor" button
# 5. Paste the variables above (replace <placeholders> with real values)
# 6. Click "Save" - Railway will automatically redeploy
# 7. Wait 2-3 minutes for deployment to complete
# 8. Test at https://www.radai.ae/login
