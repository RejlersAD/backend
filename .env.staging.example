# ============================================
# AIFlow STAGING Environment Variables
# ============================================
# Purpose: Pre-Production (Staging) environment configuration
# Deploy to: Railway Staging Project
# Branch: preprod
# ============================================

# ==========================================
# ENVIRONMENT IDENTIFICATION
# ==========================================
ENVIRONMENT=staging
DEBUG=False

# ==========================================
# DJANGO CONFIGURATION
# ==========================================
# Generate new key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY="Kx7mN#9pQ&2vR*wE5tY8uI!oP@sD3fG6hJ4kL1nM0zX+cV%bA=sQ9wE7rT5yU3i"
DJANGO_SETTINGS_MODULE=config.settings

# IMPORTANT: Include Railway domain and preprod frontend domain
ALLOWED_HOSTS=*.railway.app,aiflowbackend.railway.internal,airflow-frontend-hsx7.vercel.app,localhost,127.0.0.1

# Port Configuration for Railway
PORT=8080

# ==========================================
# DATABASE CONFIGURATION - PREPROD
# ==========================================
# Railway PostgreSQL Database for Preprod/Testing
# This configuration is for testing workloads only
DATABASE_URL=postgresql://postgres:OPMUckaUZIxVfSsWxgRKuVFbBsVKxPyk@nozomi.proxy.rlwy.net:43647/railway

# Alternative Railway reference syntax (if using Railway services):
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Manual database components (for reference/debugging):
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=OPMUckaUZIxVfSsWxgRKuVFbBsVKxPyk
DB_HOST=nozomi.proxy.rlwy.net
DB_PORT=43647
DB_ENGINE=postgresql

# Database connection pool settings for preprod
DB_CONN_MAX_AGE=600
DB_CONN_HEALTH_CHECKS=True

# ==========================================
# REDIS CONFIGURATION (Celery/Cache)
# ==========================================
# Use Railway's reference syntax
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_HOST=${{Redis.REDIS_HOST}}
REDIS_PORT=${{Redis.REDIS_PORT}}

# Manual configuration (if not using Railway Redis):
# REDIS_URL=redis://default:password@redis-staging.railway.internal:6379
# REDIS_HOST=redis-staging.railway.internal
# REDIS_PORT=6379

# ==========================================
# AWS S3 CONFIGURATION
# ==========================================
# OPTION 1: Separate staging bucket (Recommended)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=aiflow-staging-bucket
AWS_S3_REGION_NAME=us-east-1
AWS_DEFAULT_ACL=private
AWS_S3_CUSTOM_DOMAIN=aiflow-staging-bucket.s3.amazonaws.com

# OPTION 2: Same bucket with prefix (Alternative)
# AWS_STORAGE_BUCKET_NAME=aiflow-production
# AWS_LOCATION=staging/
# All staging files will be in the staging/ folder

# ==========================================
# OPENAI CONFIGURATION
# ==========================================
# You can use the same key or separate for cost tracking
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4096

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
# Use staging email or test email service
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=staging-noreply@yourdomain.com
EMAIL_HOST_PASSWORD=your-staging-email-app-password
DEFAULT_FROM_EMAIL=staging-noreply@yourdomain.com

# For testing without sending real emails:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ==========================================
# CORS CONFIGURATION
# ==========================================
# Add preprod frontend URLs
CORS_ALLOWED_ORIGINS=https://airflow-frontend-hsx7.vercel.app,https://airflow-frontend-hsx7-git-preprod.vercel.app,https://airflow-frontend-hsx7-git-dev.vercel.app
CORS_ALLOW_CREDENTIALS=True

# ==========================================
# FRONTEND URL
# ==========================================
# Used for redirects, callbacks, password reset links, etc.
FRONTEND_URL=https://airflow-frontend-hsx7.vercel.app

# ==========================================
# INTERNAL SERVICE URLS (Railway)
# ==========================================
# Use Railway's private networking for service-to-service communication
DATA_MANAGEMENT_URL=${{data-management.RAILWAY_PUBLIC_DOMAIN}}
USER_MANAGEMENT_URL=${{user-management.RAILWAY_PUBLIC_DOMAIN}}

# Or use private domains:
# DATA_MANAGEMENT_URL=https://data-management.railway.internal
# USER_MANAGEMENT_URL=https://user-management.railway.internal

# ==========================================
# CELERY CONFIGURATION
# ==========================================
CELERY_BROKER_URL=${{Redis.REDIS_URL}}
CELERY_RESULT_BACKEND=${{Redis.REDIS_URL}}
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC

# ==========================================
# LOGGING & MONITORING
# ==========================================
LOG_LEVEL=INFO
SENTRY_DSN=your-sentry-dsn-for-staging
SENTRY_ENVIRONMENT=staging

# ==========================================
# SECURITY SETTINGS
# ==========================================
# HTTPS settings for Railway deployment
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Session configuration
SESSION_COOKIE_NAME=aiflow_staging_sessionid
SESSION_COOKIE_DOMAIN=.yourdomain.com
SESSION_COOKIE_SAMESITE=Lax

# ==========================================
# FEATURE FLAGS (Optional)
# ==========================================
# Enable/disable features in staging
ENABLE_DEBUG_TOOLBAR=False
ENABLE_EXPERIMENTAL_FEATURES=True
ENABLE_API_RATE_LIMITING=True

# ==========================================
# STORAGE SETTINGS
# ==========================================
# Default file storage
DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
STATICFILES_STORAGE=storages.backends.s3boto3.S3StaticStorage

# Media files URL
MEDIA_URL=https://aiflow-staging-bucket.s3.amazonaws.com/media/
STATIC_URL=https://aiflow-staging-bucket.s3.amazonaws.com/static/

# ==========================================
# RAILWAY-SPECIFIC
# ==========================================
# Railway automatically provides these (reference only):
# RAILWAY_ENVIRONMENT=staging
# RAILWAY_PROJECT_NAME=AIFlow-Staging
# RAILWAY_SERVICE_NAME=backend
# RAILWAY_PUBLIC_DOMAIN=backend-staging-xxx.up.railway.app
# PORT=8000 (Railway auto-assigns)

# ==========================================
# API KEYS & INTEGRATIONS
# ==========================================
# Add any third-party API keys here
# STRIPE_API_KEY=sk_test_xxx (use test keys for staging)
# TWILIO_ACCOUNT_SID=xxx
# GOOGLE_API_KEY=xxx

# ==========================================
# NOTES
# ==========================================
# 1. Generate new SECRET_KEY for staging (different from production)
# 2. Use test/sandbox credentials for payment providers
# 3. Configure staging email to not send to real users
# 4. Use separate S3 bucket or prefix to avoid production data conflicts
# 5. Set ENVIRONMENT=staging to identify environment in logs
# 6. Enable more verbose logging for debugging
# 7. Test all integrations in staging before promoting to production
