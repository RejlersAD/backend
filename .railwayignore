*_knowledge_base.json
*_training_examples.json
pfd_knowledge_base.json
pfd_training_examples.json
pid_knowledge_base.json
pid_training_examples.json

# Build & Deployment Scripts (exclude dev scripts, KEEP Railway startup scripts)
git_push.ps1
push_to_github.bat
*.bat
*.ps1
docker-entrypoint.sh
railway_health_check.py
verify_railway_cors.py

