# .railwayignore - Minimize deployment size and speed up builds
# ========================================================================
# CRITICAL: Excludes ~30MB+ of unnecessary files from Railway deployments
# ========================================================================

# CRITICAL: Always include Python requirements (must NOT be excluded)
!requirements.txt
!requirements-ml.txt
!requirements-ocr.txt

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Large training data (CRITICAL - 20MB+)
pfd_training_samples/
pid_training_samples/
pid_drawings/
pfd_documents/
media/pid_drawings/
media/pfd_documents/
training_data_cache/
project_data/

# Test files and outputs
test_*/
*_test.py
test_*.py
tests/
test_outputs/
.pytest_cache/
htmlcov/
.coverage
.tox/
.mypy_cache/

# Development files
.env
.env.*
!.env.example
docker-compose*.yml
Dockerfile*
!Dockerfile
docker-entrypoint*.sh

# Generated at runtime (not needed in deployment)
staticfiles/
media/
db.sqlite3
*.log

# Documentation
*.md
!README.md
docs/

# IDE
.vscode/
.idea/
.git/
.DS_Store
*.swp
*.swo
*~

