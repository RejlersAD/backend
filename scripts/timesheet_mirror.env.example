# Copy this file to scripts/timesheet_mirror.env on the office sync machine.
# Never commit the completed file; it contains SQL and API credentials.

# Matrix SQL Server (reachable only from the office network)
TIMESHEET_HOST=192.168.99.52
TIMESHEET_PORT=1433
TIMESHEET_USER=<sql-user>
TIMESHEET_PASSWORD=<sql-password>
TIMESHEET_DATABASE=matrix
TIMESHEET_TABLE=dbo.Mx_VEW_UserAttendanceEvents

# Matrix event-stream mapping
TIMESHEET_COL_EMP_CODE=UserID
TIMESHEET_COL_EMP_NAME=FullName
TIMESHEET_COL_DEPARTMENT=DptName
TIMESHEET_COL_PUNCH_TIME=EventDateTime
TIMESHEET_COL_PUNCH_TYPE=EntryExitType
TIMESHEET_COL_IN_VALUE=0
TIMESHEET_COL_OUT_VALUE=1

# Production receives outbound HTTPS requests from this agent.
TIMESHEET_MIRROR_URL=https://backend-production-3883.up.railway.app/api/v1/timesheet
# Copy the existing TIMESHEET_MIRROR_API_KEY value from Railway exactly.
TIMESHEET_MIRROR_API_KEY=<same-value-as-railway>
TIMESHEET_MIRROR_HTTP_TIMEOUT=60

# Optional user-master enrichment
TIMESHEET_USER_DETAILS_TABLE=dbo.Mx_VEW_UserDetails
TIMESHEET_USER_DETAILS_JOIN_COL=UserID
TIMESHEET_USER_DETAILS_COLUMNS=Card1,OfficeEmail:office_email,PersEmail:personal_email,FullName:full_name,DptName:department
